---
const domains = [
  {num:'01',name:'AI Strategy',desc:'Workflow priorities, technology investment, vendor evaluation, and build-versus-buy decisions.'},
  {num:'02',name:'Agents and Automation',desc:'Task design, tool use, integrations, and human review for AI-enabled workflows.'},
  {num:'03',name:'Evaluation',desc:'Task-specific quality criteria, baselines, failure analysis, and deployment thresholds.'},
  {num:'04',name:'Adoption',desc:'Workflow redesign, practical training, feedback, and clear ownership after launch.'},
  {num:'05',name:'Governance and Risk',desc:'Data handling, oversight, accountability, and the limits of automated decisions.'},
  {num:'06',name:'AI Infrastructure',desc:'Exploring the power, water, and physical systems behind AI through independent research.'},
];
---
<section id="domains" aria-labelledby="domains-heading" class="border-t border-rule py-24 md:py-32">
  <header class="mb-10">
    <p class="font-mono text-[10px] tracking-[0.18em] text-ink-3 mb-3">// 03 — EXPERTISE</p>
    <h2 id="domains-heading" class="font-serif font-light text-[clamp(1.6rem,3.2vw,2.6rem)] text-ink">Where the work lives.</h2>
  </header>
  <div class="grid sm:grid-cols-2 gap-px bg-rule">
    {domains.map(d => (
      <article class="bg-parchment p-7">
        <p class="font-mono text-[10px] text-ink-3 mb-3">{d.num}</p>
        <h3 class="font-serif text-xl text-ink mb-3">{d.name}</h3>
        <p class="text-sm text-ink-2 leading-relaxed">{d.desc}</p>
      </article>
    ))}
  </div>
</section>
