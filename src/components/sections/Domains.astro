---
const domains = [
  {
    "num": "01",
    "name": "AI Strategy",
    "desc": "Enterprise AI priorities, technology investment, governance, and vendor evaluation."
  },
  {
    "num": "02",
    "name": "AI Transformation",
    "desc": "Workflow redesign, operational improvement, employee adoption, training, and change management."
  },
  {
    "num": "03",
    "name": "Agent Development",
    "desc": "AI agents, automation, evaluation, and embedded quality controls for professional workflows."
  },
  {
    "num": "04",
    "name": "Executive Advisory Programs",
    "desc": "Client advisory boards, C-suite engagement, executive recruitment, roundtable facilitation, and community management."
  },
  {
    "num": "05",
    "name": "Executive Research and Thought Leadership",
    "desc": "Executive interviews, analysis, reports, strategic recommendations, and technically validated content."
  },
  {
    "num": "06",
    "name": "Commercial Strategy",
    "desc": "Enterprise relationships, account expansion, sales intelligence, and go-to-market planning."
  },
  {
    "num": "07",
    "name": "Organizational Leadership",
    "desc": "Business operations, cross-functional leadership, product development, budgets, and organizational change."
  },
  {
    "num": "08",
    "name": "Governance and Risk",
    "desc": "AI governance, enterprise risk, cybersecurity leadership discussions, and responsible technology adoption."
  }
];
---
<section id="domains" aria-labelledby="domains-heading" class="border-t border-rule py-24 md:py-32">
  <header class="mb-10">
    <p class="font-mono text-[10px] tracking-[0.18em] text-ink-3 mb-3">// 04 — EXPERTISE</p>
    <h2 id="domains-heading" class="font-serif font-light text-[clamp(1.6rem,3.2vw,2.6rem)] text-ink">Where the work lives.</h2>
  </header>
  <div class="grid sm:grid-cols-2 gap-px bg-rule">
    {domains.map(d => (
      <article class="bg-parchment p-7">
        <p class="font-mono text-[10px] text-ink-3 mb-3">{d.num}</p>
        <h3 class="font-serif text-xl text-ink mb-3">{d.name}</h3>
        <p class="text-sm text-ink-2 leading-relaxed">{d.desc}</p>
      </article>
    ))}
  </div>
</section>
