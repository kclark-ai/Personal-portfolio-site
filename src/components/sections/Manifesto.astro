---
const principles = [
  ['Judge the system in the workflow.', 'Model capability matters, but so do the decisions the system supports, the review it requires, and the feedback it creates.'],
  ['Adoption needs an owner.', 'A tool can work in testing and still fail in daily use. Workflow design, trust, and practical training need as much attention as the integration.'],
  ['Define quality before scale.', 'Good enough for what, compared to what, according to whom, at what cost? These are investment decisions as well as technical questions.'],
  ['Internal transformation has different constraints.', 'Changing an employee workflow consumes attention and trust. The pace of change needs to account for both.'],
  ['Strategy needs execution infrastructure.', 'Governance, evaluation, and reliable systems make strategic choices usable. They belong in the strategy from the beginning.'],
];
---
<section id="manifesto" aria-labelledby="manifesto-heading" class="border-t border-rule py-24 md:py-32">
  <header class="mb-10">
    <p class="font-mono text-[10px] tracking-[0.18em] text-ink-3 mb-3">// 07 — PERSPECTIVE</p>
    <h2 id="manifesto-heading" class="font-serif font-light text-[clamp(1.6rem,3.2vw,2.6rem)] text-ink">What I believe about AI in enterprise.</h2>
  </header>
  <p class="text-sm text-ink-2 mb-8">These principles inform my work on enterprise AI.</p>
  {principles.map(([heading, body]) => (
    <details class="border-t border-rule py-5">
      <summary class="font-serif text-xl cursor-pointer">{heading}</summary>
      <p class="text-sm text-ink-2 leading-relaxed mt-4">{body}</p>
    </details>
  ))}
</section>
